# Neon Postgres — copy from Neon console → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin auth — generate a strong random secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your-random-secret-here

# The password you type at /admin/login
ADMIN_PASSWORD=choose-a-strong-password

# TOTP 2FA — run once: node scripts/setup-totp.mjs
# Copy the secret it prints, scan with Google Authenticator
TOTP_SECRET=your-totp-secret-here

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile → Add site
# Site key goes here (public, safe to expose)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Turnstile secret key (keep private — server only)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
